# Twilio
# Find these values at https://console.twilio.com.
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH=your_auth_token_here
TWILIO_NUMBER=+18555077602
TWILIO_NUMBERS=+18555077602,+18444844459
TWILIO_NUMBER_LABELS=Cancellation,Sales
TWILIO_STUDIO_FLOW_URL=https://webhooks.twilio.com/v1/Accounts/ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/Flows/FWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Sheets
# Copy the spreadsheet ID from https://docs.google.com/spreadsheets/d/<THIS_PART>/edit.
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_CALLBACKS_TAB=Callbacks
GOOGLE_SHEET_LOGS_TAB=CallLogs
GOOGLE_SHEET_CALL_ROUTING_TAB=Call Routing

# Paste the entire service account JSON on one line.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...@...iam.gserviceaccount.com",...}

# App authentication
AFFILIATE_ACCESS_CODE=your_access_code_here

# Dashboard-managed call routing
CALL_ROUTING_SECRET=generate_a_long_random_secret
CALL_ROUTING_DEFAULT_AGENTS=+15551234567

# Optional local webhook host override. Leave blank on Vercel.
# PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.app
